{
  config,
  lib,
  pkgs,
  ...
}:
let
  port = 27960;
  package = pkgs.urbanterror;
  mapCycle = [
    "ut4_turnpike"
    # "ut4_paris"
    "ut4_algiers"
    # "ut4_bohemia"
    "ut4_kingdom"
    {
      map = "ut4_austria";
      settings.g_gametype = 0;
    }
    "ut4_sanc"
    "ut4_abbey"
    {
      map = "ut4_prague";
      settings.g_gametype = 0;
    }
    # "ut4_cascade"
    # "ut4_mandolin"
    {
      map = "ut4_uptown";
      settings.g_gametype = 0;
    }
    # "ut4_kingpin"
    # "ut4_elgin"
    # "ut4_oildepot"
    # "ut4_ghosttown"
    # "ut4_swim"
    # "ut4_prominence"
    "ut4_ramelle"
    # "ut4_raiders"
    "ut4_riyadh"
    # "ut4_mykonos_a17"
    "ut4_eagle"
    # "ut4_suburbs"
    # "ut4_subway"
    # "ut4_thingley"
    # "ut4_tombs"
    # "ut4_docks"
    # "ut4_ricochet"
    # "ut4_herring"
    # "ut4_killroom"
    "ut4_casa"
  ];
  defaultGametype = 3; # TDM
  mapName = e: if builtins.isString e then e else e.map;
  mapEntry =
    e:
    let
      settings = {
        g_gametype = defaultGametype;
      }
      // (if builtins.isString e then { } else e.settings or { });
    in
    ''
      ${mapName e}
      {
      ${lib.concatStringsSep "\n" (lib.mapAttrsToList (n: v: "  ${n} ${sanitise v}") settings)}
      }'';
  mapcycleText = lib.concatStringsSep "\n" (map mapEntry mapCycle) + "\n";
  startMap = mapName (lib.head mapCycle);

  # Config values are read by the Quake 3 console parser: a bare quote would
  # truncate the directive and a semicolon would start a new command.
  sanitise = v: lib.replaceStrings [ ''"'' ";" "\n" ] [ "'" "" " " ] (toString v);
  setting = n: v: "set ${if n == lib.trim n then n else ''"${n}"''} \"${sanitise v}\"";

  # The sops env file is appended on top of these, so any of them can be
  # overridden at start-up without touching this module.
  base = {
    sv_hostname = "Urban Terror server";
    sv_maxclients = 24;
    sv_joinmessage = "Welcome to Urban Terror";
    g_motd = "";
    sv_dlURL = "urbanterror.info";

    auth_enable = 1;
    auth_notoriety = 0;
    auth_tags = 1;
    auth_cheaters = 1;

    g_log = "games.log";
    g_logsync = 1;
    g_loghits = 0;
    g_logroll = 0;

    g_referee = 0;
    g_refpass = "";
    filterban = 1;

    sv_pure = 1;
    sv_floodprotect = 2;
    sv_privateclients = 0;
    sv_timeout = 120;
    sv_maxping = 0;
    sv_clientsPerIp = 3;
    sv_maxrate = 0;
    sv_minrate = 0;
    sv_strictauth = 0;

    g_password = "";
    g_skins = 1;
    g_armbands = 1;
    g_funstuff = 1;
    g_gear = "K"; # no HK
    g_allowvote = 603981055;
    g_failedvotetime = 300;
    g_maxGameClients = 0;
    g_allowchat = 2;
    g_deadchat = 2;
    g_inactivity = 0;

    g_gametype = 3; # TDM
    g_followstrict = 1;
    g_warmup = 15;
    g_gravity = 800;
    g_knockback = 1000;
    g_antiwarp = 1;
    g_antiwarptol = 50;
    g_shuffleNoRestart = 1;
    g_inactivityAction = 1;

    timelimit = 20;
    fraglimit = 0;

    # 1 = friendly fire on + kick after g_maxteamkills TK's, 2 = on without
    # kicks, 0 = off. Bots do not account for friendly fire and shoot their
    # own team, so 0 (the UrT default) is the only sane value with bots.
    g_friendlyfire = 0;
    g_maxteamkills = 3;
    g_teamkillsforgettime = 200;
    g_teamautojoin = 1;
    g_teamforcebalance = 1;
    g_autobalance = 1;
    g_maintainteam = 1;
    g_swaproles = 0;
    g_matchmode = 0;

    g_respawnprotection = 2;
    g_respawndelay = 5;
    g_forcerespawn = 20;
    g_waverespawns = 0;
    g_bluewave = 15;
    g_redwave = 15;

    g_maxrounds = 0;
    g_roundtime = 2;
    g_survivorrule = 0;
    g_suddendeath = 0;

    capturelimit = 0;
    g_flagreturntime = 30;
    g_hotpotato = 1;
    g_cahtime = 30;

    g_bombdefusetime = 5;
    g_bombexplodetime = 30;
    g_bombplanttime = 3;

    g_walljumps = 3;
    g_thawTime = 6;
    g_meltdownTime = 60;

    bot_enable = 1;
    bot_minplayers = 20;

    g_mapcycle = "mapcycle.txt";
  };

  serverCfg = pkgs.writeText "urbanterror-server.cfg" ''
    // Generated by services.urbanterror. Manual edits are overwritten at start.
    // Defaults only; urbanterror-prepare appends the sops env file on top.
    ${lib.concatStringsSep "\n" (lib.mapAttrsToList setting base)}
  '';

  envFile = config.sops.secrets."urbanterror_env".path;

  mapcycle = pkgs.writeText "urbanterror-mapcycle.txt" mapcycleText;

  # The engine reads configs from fs_homepath, which has to be writable; the
  # store copy is the source of truth and is re-rendered on every start.
  prepare = pkgs.writeShellScript "urbanterror-prepare" ''
    set -eu
    : "''${rconpassword:?rconpassword is missing from the sops env file}"
    if ss -lunH "sport = :${toString port}" | grep -q .; then
      echo "UDP port ${toString port} is already in use; refusing to start a second daemon" >&2
      exit 1
    fi

    # Same rules as the Nix-side sanitiser: a quote would truncate the
    # directive, a semicolon would start a new command.
    q3value() {
      local v=$1
      v=''${v//\"/\'}
      v=''${v//;/}
      v=''${v//$'\n'/ }
      printf '%s' "$v"
    }

    cfg="$STATE_DIRECTORY/q3ut4/server.cfg"
    install -d -m 0750 "$STATE_DIRECTORY/q3ut4"
    install -m 0640 ${serverCfg} "$cfg"
    install -m 0640 ${mapcycle} "$STATE_DIRECTORY/q3ut4/mapcycle.txt"

    # Everything in the sops env file is applied on top of the defaults above
    # (the last `set` wins): `SETS_<name>` becomes a server-browser tag
    # (`SETS_Admin` -> `sets " Admin"`), any other key is a cvar.
    while IFS='=' read -r key value; do
      case "$key" in
        "" | "#"*) continue ;;
        SETS_*) printf 'sets " %s" "%s"\n' "''${key#SETS_}" "$(q3value "$value")" ;;
        *) printf 'set "%s" "%s"\n' "$key" "$(q3value "$value")" ;;
      esac
    done < ${envFile} >> "$cfg"

    printf 'map %s\n' ${lib.escapeShellArg (sanitise startMap)} >> "$cfg"
  '';
in
{
  sops.secrets."urbanterror_env" = {
    sopsFile = ../../secrets/urbanterror.yaml;
    group = "urbanterror";
    mode = "0440";
    restartUnits = [ "urbanterror.service" ];
  };

  users.users.urbanterror = {
    isSystemUser = true;
    group = "urbanterror";
    home = "/var/lib/urbanterror";
  };
  users.groups.urbanterror = { };

  networking.firewall.allowedUDPPorts = [ port ];

  systemd.services.urbanterror = {
    description = "Urban Terror dedicated server";
    wantedBy = [ "multi-user.target" ];
    wants = [ "network-online.target" ];
    after = [
      "network-online.target"
      "sops-nix.service"
    ];
    restartTriggers = [
      serverCfg
      mapcycle
    ];
    path = [
      pkgs.coreutils
      pkgs.iproute2
    ];

    serviceConfig = {
      Type = "simple";
      User = "urbanterror";
      Group = "urbanterror";
      StateDirectory = "urbanterror";
      StateDirectoryMode = "0750";
      Environment = [ "HOME=%S/urbanterror" ];
      EnvironmentFile = config.sops.secrets."urbanterror_env".path;
      ExecStartPre = prepare;
      ExecStart = lib.concatStringsSep " " [
        "${package}/bin/urbanterror-ded"
        "+set fs_basepath ${package}/share/urbanterror"
        "+set fs_homepath %S/urbanterror"
        "+set fs_game q3ut4"
        "+set dedicated 2"
        "+set net_port ${toString port}"
        "+set com_hunkmegs 128"
        "+set sv_allowdownload 1"
        "+exec server.cfg"
      ];
      Restart = "on-failure";
      RestartSec = 10;
      TimeoutStopSec = 20;
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ProtectKernelTunables = true;
      ProtectControlGroups = true;
      RestrictAddressFamilies = [
        "AF_INET"
        "AF_INET6"
        "AF_NETLINK"
        "AF_UNIX"
      ];
    };
  };
}
